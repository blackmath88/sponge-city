{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blackmath88/sponge-city/adaptive-interface/contracts/intervention-knowledge.schema.json",
  "title": "Intervention knowledge (intervention-knowledge/0.1)",
  "description": "Researcher-facing description of interventions: what it is, why, mechanisms, requirements, constraints, Basel examples, sources. Contains NO renderer fields (layout, coordinates, colours, stages) and NO execution operations: runtime/intervention-compiler.js turns a record + state into state operations. Records may exist before the compiler has a recipe for them.",
  "type": "object",
  "required": ["schema_version", "interventions"],
  "properties": {
    "schema_version": { "const": "intervention-knowledge/0.1" },
    "catalogue_id": { "type": "string" },
    "label": { "type": "string" },
    "note": { "type": "string" },
    "interventions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": { "label": { "type": "string" }, "url": { "type": "string" }, "note": { "type": "string" }, "date": { "type": "string" } }
    },
    "record": {
      "type": "object",
      "required": ["id", "label", "category", "description", "mechanisms", "applies_to", "requirements", "constraints", "basel_examples", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string" },
        "category": { "enum": ["surface", "routing", "storage-infiltration", "vegetation", "reuse"] },
        "description": { "type": "string" },
        "mechanisms": { "type": "array", "items": { "enum": ["ABSORB", "STORE", "SLOW", "SWEAT", "SHADE", "COOL"] }, "description": "Public explanatory vocabulary, not the scientific schema." },
        "applies_to": {
          "type": "object",
          "additionalProperties": false,
          "required": ["element_types"],
          "description": "What kind of place element this is about, in semantic terms.",
          "properties": {
            "element_types": { "type": "array", "items": { "type": "string" } },
            "surface_classes": { "type": "array", "items": { "enum": ["sealed", "permeable", "planted", "water"] } },
            "receives_into": { "type": "array", "items": { "type": "string" }, "description": "Routing interventions: element types that can receive the water" }
          }
        },
        "state_changes": { "type": "array", "items": { "type": "string" }, "description": "Prose: how the place changes (e.g. 'sealed fraction falls'). Read by engineers writing the compiler recipe." },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "state_key": { "type": "string", "pattern": "^context\\.[a-z0-9_]+$", "description": "Optional link to the place evidence that answers it. Unknown → requires-investigation." },
              "excluded_when": { "type": "array", "description": "Values of state_key that rule the intervention out" },
              "note": { "type": "string" }
            }
          }
        },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "basel_examples": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "notes": { "type": "string" }
      }
    }
  }
}
